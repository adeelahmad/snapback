# Managed by snapback; do not edit.
[Unit]
Description=Snapback .snapshot history
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=alice
ExecStart=/usr/local/bin/snapback run --config /etc/snapback/config.yaml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
